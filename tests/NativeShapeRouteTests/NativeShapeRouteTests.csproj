    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <HooksRuntimeDirectory Condition="'$(HooksRuntimeDirectory)' == ''">C:/Program Files (x86)/Steam/steamapps/common/FINAL FANTASY TACTICS - The Ivalice Chronicles/FFTModLoader.Runtime/ResolvedMods/reloaded.sharedlib.hooks/x64</HooksRuntimeDirectory>
  </PropertyGroup>
  <ItemGroup>
